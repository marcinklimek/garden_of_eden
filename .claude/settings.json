{
  "extraKnownMarketplaces": {
    "claude-workflow-kit": {
      "source": {
        "source": "github",
        "repo": "marcinklimek/claude-workflow-kit"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "kit-core@claude-workflow-kit": true,
    "kit-board@claude-workflow-kit": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git worktree list:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ]
  }
}
